package templates

templ Portfolio() {
	@Base("/portfolio") {
		<section class="section">
			<div class="container">
				<span class="section-label">Case Studies</span>
				<h2 class="section-title">Selected Work</h2>
				<p class="section-subtitle">
					Fewer bugs, every time. Here&rsquo;s how.
				</p>
				<div class="cards">
					<div class="card portfolio-card">
						<div class="card-image">Android &bull; iOS &bull; Web</div>
						<h3>Multi-Platform E2E Suites — From Scratch</h3>
						<p>
							Planned and built complete end-to-end test suites for
							Android, iOS, and web platforms across multiple
							projects — zero tests to full coverage. Any platform,
							any language, any framework.
						</p>
						<div class="card-tags">
							<span class="tag">Playwright</span>
							<span class="tag">Appium</span>
							<span class="tag">Detox</span>
							<span class="tag">CI/CD</span>
						</div>
					</div>
					<div class="card portfolio-card">
						<div class="card-image">Flutter &bull; Mobile</div>
						<h3>Sole QA for Two Flutter App Launches</h3>
						<p>
							Owned the entire quality pipeline as the only QA
							professional for two Flutter apps. Manual UAT, test
							automation, bug triage, and release sign-off — both
							launched on schedule with zero critical defects.
						</p>
						<div class="card-tags">
							<span class="tag">Flutter</span>
							<span class="tag">UAT</span>
							<span class="tag">Android</span>
							<span class="tag">iOS</span>
						</div>
					</div>
					<div class="card portfolio-card">
						<div class="card-image">Process &bull; Strategy</div>
						<h3>QA Process from the Ground Up</h3>
						<p>
							Introduced structured QA practices into teams that
							had none — test planning, bug triage workflows, and
							automation roadmaps. Fewer escaped defects, faster
							releases, and developers who actually enjoy testing.
						</p>
						<div class="card-tags">
							<span class="tag">Test Strategy</span>
							<span class="tag">Process Design</span>
							<span class="tag">Mentoring</span>
							<span class="tag">Jira</span>
						</div>
					</div>
				</div>
			</div>
		</section>
	}
}
