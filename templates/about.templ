package templates

import "qa-contractor/templates/components"

templ About() {
	@Base("/about") {
		<section class="section">
			<div class="container">
				<span class="section-label">Experience</span>
				<h2 class="section-title">About Me</h2>
				<div class="about-grid">
					<div>
						<div class="about-image">&#128104;&#8205;&#128187;</div>
						<div class="skills" style="margin-top: 2rem;">
							<span class="skill skill-highlight">Playwright</span>
							<span class="skill skill-highlight">Cypress</span>
							<span class="skill">Selenium</span>
							<span class="skill">Appium</span>
							<span class="skill">Detox</span>
							<span class="skill">TypeScript</span>
							<span class="skill">Python</span>
							<span class="skill">Go</span>
							<span class="skill">Postman</span>
							<span class="skill">Docker</span>
							<span class="skill">GitHub Actions</span>
							<span class="skill">GitLab CI</span>
							<span class="skill">SQL</span>
							<span class="skill">Jira</span>
						</div>
					</div>
					<div class="about-text">
						<p>
							I&rsquo;m Kyle Reynolds, a QA contractor who has
							led quality for multiple products — mobile apps and
							web platforms — all at the same time. I go from
							manual UAT sessions straight through to writing
							complete end-to-end test suites from scratch.
						</p>
						<p>
							I specialise in test automation (Playwright, Cypress,
							Selenium, Appium) across mobile and web, designing
							pragmatic QA processes, and making sure nothing slips
							through the cracks — no matter how many products are
							in flight.
						</p>
						<p>
							When I&rsquo;m not breaking software on purpose, I
							contribute to open-source testing tools and write
							about quality engineering best practices.
						</p>

						<div class="timeline">
							<div class="timeline-item">
								<div class="period">2023 &ndash; Present</div>
								<div class="title">Senior QA Engineer</div>
								<div class="company">Freelance / Contract</div>
								<div class="description">
									Lead QA for multiple products including
									mobile apps and web platforms. Built E2E
									suites for Android, iOS, and web from
									scratch. Sole QA for two Flutter app
									launches.
								</div>
							</div>
							<div class="timeline-item">
								<div class="period">2020 &ndash; 2023</div>
								<div class="title">QA Lead</div>
								<div class="company">TechCo (placeholder)</div>
								<div class="description">
									Led a team of 4 QA engineers. Reduced
									release cycles from 2 weeks to 3 days by
									introducing risk-based testing and
									automated regression suites.
								</div>
							</div>
							<div class="timeline-item">
								<div class="period">2017 &ndash; 2020</div>
								<div class="title">QA Engineer</div>
								<div class="company">StartupX (placeholder)</div>
								<div class="description">
									First QA hire. Built the testing practice
									from scratch — manual testing, then
									automation with Selenium and CI
									integration.
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section" style="padding-top: 0;">
			<div class="container">
				<span class="section-label">Testimonials</span>
				<h2 class="section-title">What Clients Say</h2>
				<div class="cards">
					@components.Testimonial(
						"Brought a level of rigor to our QA process that we didn't know we needed. Our release confidence is night-and-day better now.",
						"Alex Chen",
						"CTO, FinScale",
						"AC",
					)
					@components.Testimonial(
						"Delivered a Playwright suite that runs in 8 minutes and catches regressions before they hit staging. Incredible ROI.",
						"Maria Silva",
						"Engineering Manager, ShopFlow",
						"MS",
					)
					@components.Testimonial(
						"The load tests uncovered bottlenecks we'd been chasing for months. Clear reports, actionable recommendations.",
						"James Wright",
						"VP Engineering, DataPulse",
						"JW",
					)
				</div>
			</div>
		</section>
	}
}
